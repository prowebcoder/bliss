{%- comment -%}
  Flute / refill reminder pop-up (BlissThera).
  When a shopper clicks Checkout:
    - more refills than flutes  -> "Would you like to order more flutes?"
    - more flutes than refills  -> "Would you like to purchase flute refills?"
    - equal, or neither in cart -> straight to checkout
  Counts only the RETAIL Forest Myst Flute and RETAIL refills,
  so wholesale orders never see it.
{%- endcomment -%}

{%- assign rfr_flute_id = 10234526826805 -%}
{%- assign rfr_flute_url = '/products/forest-myst-flute-for-blissthera%C2%AE-and-mindscape%C2%AE-nectar-formulas' -%}
{%- assign rfr_refill_collection = collections['forest-myst-refill-nectars-mindscape™-blissthera™-formulas-retail'] -%}

{%- capture rfr_refill_ids -%}
  {%- comment %}<locksmith:4d9c>{% endcomment -%}
    {%- assign locksmith_8b75_forloop__size = 0 %}{%- for rfr_product in rfr_refill_collection.products -%}{% capture var %}{% render 'locksmith-variables', scope: 'subject', subject: rfr_product, subject_parent: rfr_refill_collection, variable: 'transparent' %}{% endcapture %}{% if var == 'true' %}{% assign locksmith_8b75_forloop__size = locksmith_8b75_forloop__size | plus: 1 %}{% endif %}{% endfor %}{% assign locksmith_8b75_forloop__index = nil -%}
  {%- comment %}</locksmith:4d9c>{% endcomment -%}
  {%- for rfr_product in rfr_refill_collection.products -%}
    {%- comment %}<locksmith:e852>{% endcomment -%}
      {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: rfr_product, subject_parent: rfr_refill_collection, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% if locksmith_8b75_forloop__index == nil %}{% assign locksmith_8b75_forloop__index = 1 %}{% assign locksmith_8b75_forloop__index0 = 0 %}{% else %}{% assign locksmith_8b75_forloop__index = locksmith_8b75_forloop__index | plus: 1 %}{% assign locksmith_8b75_forloop__index0 = locksmith_8b75_forloop__index0 | plus: 1 %}{% endif %}{% if locksmith_8b75_forloop__index == 1 %}{% assign locksmith_8b75_forloop__first = true %}{% else %}{% assign locksmith_8b75_forloop__first = false %}{% endif %}{% if locksmith_8b75_forloop__index == locksmith_8b75_forloop__size %}{% assign locksmith_8b75_forloop__last = true %}{% else %}{% assign locksmith_8b75_forloop__last = false %}{% endif %}{% assign locksmith_8b75_forloop__rindex = locksmith_8b75_forloop__size | minus: locksmith_8b75_forloop__index | minus: 1 %}{% assign locksmith_8b75_forloop__rindex0 = locksmith_8b75_forloop__size | minus: locksmith_8b75_forloop__index0 | minus: 1 %}{% else %}{% continue %}{% endif -%}
    {%- comment %}</locksmith:e852>{% endcomment -%}
    {{- rfr_product.id -}}{%- unless locksmith_8b75_forloop__last -%},{%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}

<style>
  #RefillReminder { display: none; position: fixed; inset: 0; z-index: 100000; align-items: center; justify-content: center; padding: 1.6rem; }
  #RefillReminder.rfr--open { display: flex; }
  #RefillReminder .rfr__overlay { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.55); }
  #RefillReminder .rfr__panel { position: relative; z-index: 1; width: 100%; max-width: 440px; padding: 3.2rem 2.4rem 2.4rem; border-radius: 10px; text-align: center; background: rgb(var(--color-background, 255, 255, 255)); color: rgb(var(--color-foreground, 18, 18, 18)); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25); }
  #RefillReminder .rfr__x { position: absolute; top: 0.8rem; right: 1.2rem; background: none; border: none; font-size: 2.8rem; line-height: 1; cursor: pointer; color: inherit; }
  #RefillReminder .rfr__title { margin: 0 0 0.8rem; font-size: 2rem; line-height: 1.3; }
  #RefillReminder .rfr__text { margin: 0 0 2.2rem; font-size: 1.5rem; line-height: 1.5; }
  #RefillReminder .rfr__actions { display: flex; flex-direction: column; gap: 1rem; }
  #RefillReminder .rfr__actions .button { width: 100%; }
  #RefillReminder .rfr__actions .button--secondary { background: transparent; color: rgb(var(--color-foreground, 18, 18, 18)); box-shadow: inset 0 0 0 1px rgb(var(--color-foreground, 18, 18, 18)); }
</style>

<div id="RefillReminder" role="dialog" aria-modal="true" aria-labelledby="RefillReminderTitle">
  <div class="rfr__overlay" data-rfr-close></div>
  <div class="rfr__panel">
    <button type="button" class="rfr__x" data-rfr-close aria-label="Close">&times;</button>
    <h3 id="RefillReminderTitle" class="rfr__title" data-rfr-title></h3>
    <p class="rfr__text" data-rfr-text></p>
    <div class="rfr__actions">
      <a class="button" href="{{ rfr_flute_url }}" data-rfr-shop></a>
      <button type="button" class="button button--secondary" data-rfr-continue>
        Continue to checkout
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('RefillReminder');
    if (!root) return;

    var config = {
      fluteIds: [{{ rfr_flute_id }}],
      refillIds: [{{ rfr_refill_ids | strip }}],
      fluteUrl: {{ rfr_flute_url | json }}
    };

    var shopRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    var checkoutUrl = shopRoot + 'checkout';

    var titleEl = root.querySelector('[data-rfr-title]');
    var textEl = root.querySelector('[data-rfr-text]');
    var shopEl = root.querySelector('[data-rfr-shop]');
    var continueEl = root.querySelector('[data-rfr-continue]');

    var dismissed = false;
    var busy = false;

    var messages = {
      flutes: {
        title: 'Would you like to order more flutes?',
        text: 'Each Flute holds only one Formula.',
        button: 'Shop Flutes'
      },
      refills: {
        title: 'Would you like to purchase flute refills?',
        text: 'Flutes do not include refills.',
        button: 'Shop Refills'
      }
    };

    function openReminder(type) {
      var m = messages[type];
      titleEl.textContent = m.title;
      textEl.textContent = m.text;
      shopEl.textContent = m.button;
      shopEl.setAttribute('href', config.fluteUrl);
      root.classList.add('rfr--open');
      document.body.style.overflow = 'hidden';
    }

    function closeReminder() {
      root.classList.remove('rfr--open');
      document.body.style.overflow = '';
    }

    function goToCheckout() {
      window.location.href = checkoutUrl;
    }

    function countCart(cart) {
      var flutes = 0;
      var refills = 0;
      (cart.items || []).forEach(function (item) {
        if (config.fluteIds.indexOf(item.product_id) !== -1) {
          flutes += item.quantity;
        } else if (config.refillIds.indexOf(item.product_id) !== -1) {
          refills += item.quantity;
        }
      });
      return { flutes: flutes, refills: refills };
    }

    document.addEventListener('click', function (event) {
      if (dismissed || !event.target.closest) return;
      var trigger = event.target.closest('button[name="checkout"], input[name="checkout"], a[href$="/checkout"]');
      if (!trigger) return;

      event.preventDefault();
      event.stopPropagation();
      if (busy) return;
      busy = true;

      fetch(shopRoot + 'cart.js', { headers: { Accept: 'application/json' } })
        .then(function (response) { return response.json(); })
        .then(function (cart) {
          var counts = countCart(cart);
          if (counts.refills > counts.flutes) {
            openReminder('flutes');
          } else if (counts.flutes > counts.refills) {
            openReminder('refills');
          } else {
            goToCheckout();
          }
        })
        .catch(function () { goToCheckout(); })
        .then(function () { busy = false; });
    }, true);

    root.querySelectorAll('[data-rfr-close]').forEach(function (el) {
      el.addEventListener('click', function () {
        dismissed = true;
        closeReminder();
      });
    });

    continueEl.addEventListener('click', function () {
      closeReminder();
      goToCheckout();
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && root.classList.contains('rfr--open')) {
        dismissed = true;
        closeReminder();
      }
    });
  })();
</script>